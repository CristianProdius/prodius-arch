# Database
DATABASE_URL=postgresql://user:password@localhost:5432/prodius_arch

# Better Auth
BETTER_AUTH_SECRET=<random-32-char-string>
BETTER_AUTH_URL=http://localhost:3000

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=prodius-arch
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:9000/prodius-arch

# Google Gemini
GEMINI_API_KEY=<your-google-api-key>

# Optional OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
